      }
    },
    "panel.copy_translation" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Copy Translation" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "复制译文" } }
      }
    },
    "panel.failure_title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Translation Incomplete" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "翻译未完成" } }
      }
    },
    "panel.idle_message" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "TranslateDot will show the system translation here." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "TranslateDot 会在这里显示系统翻译结果。" } }
      }
    },
    "panel.idle_title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Select text, then press ⌥D" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "选择文本后按 ⌥D" } }
      }
    },
    "panel.no_selection_title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "No translatable selection" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没有可翻译的选区" } }
      }
    },
    "panel.open_settings" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Open System Settings" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开系统设置" } }
      }
    },
    "panel.permission_message" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "TranslateDot only uses this permission to read text you explicitly select. After granting access, the app checks automatically." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "TranslateDot 只使用此权限读取你主动选中的文本。授权后，应用会自动检查权限是否已经生效。" } }
      }
    },
    "panel.permission_title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Accessibility Permission Required" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "需要辅助功能权限" } }
      }
    },
    "panel.preparing_model" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Preparing language model…" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在准备语言模型…" } }
      }
    },
    "panel.unsupported_title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Not Supported" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "暂不支持" } }
      }
    },
    "permission.activated" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Permission is active. Return to the original app, select the text again, then press ⌥D." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "权限已生效。请返回原应用、重新选择文本，然后按 ⌥D。" } }
      }
    },
    "permission.granted" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Permission granted. Select text in another app, then press ⌥D." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "权限已授予。请在其他应用中选择文本，然后按 ⌥D。" } }
      }
    }
