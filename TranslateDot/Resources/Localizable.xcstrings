      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Accessibility Permission: Granted" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "辅助功能权限：已授权" } }
      }
    },
    "menu.open_accessibility_settings" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Accessibility Settings…" } },
