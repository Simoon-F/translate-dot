{
  "sourceLanguage" : "en",
  "strings" : {
    "error.ax_failure" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Couldn't read the selected text. Try again." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "读取选中文本失败，请重试。" } }
      }
    },
    "error.empty_translation" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The system returned no translation. Try again." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "系统没有返回翻译结果，请重试。" } }
      }
    },
    "error.focus_unavailable" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Couldn't read the current focus. Return to the original app and select the text again." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法读取当前焦点。请返回原应用并重新选择文本。" } }
      }
    },
    "error.no_selection" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Select some text first." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请先选择需要翻译的文本。" } }
      }
    },
    "error.nothing_to_translate" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The selected text contains nothing to translate." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "选中的文本没有可翻译内容。" } }
      }
    },
    "error.permission_required" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Accessibility permission is required to read selected text in other apps." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "需要辅助功能权限才能读取其他应用中选中的文本。" } }
      }
    },
    "error.same_language" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The source and target languages are the same." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "检测到源语言与目标语言相同。" } }
      }
    },
    "error.selection_too_long" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The selected text is too long. Keep it under %lld characters." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "选中的文本过长，请控制在 %lld 个字符以内。" } }
      }
    },
    "error.selection_unsupported" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This app doesn't currently support direct text selection." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前应用暂不支持直接取词。" } }
      }
    },
    "error.translation_failed" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Translation failed. Check the language model and try again." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "翻译失败。请检查语言模型后重试。" } }
      }
    },
    "error.translation_unsupported" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Apple Translation doesn't support this language pair." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Apple Translation 暂不支持当前语言组合。" } }
      }
    },
    "error.unable_identify_language" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Couldn't reliably identify the source language. Select a longer passage and try again." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法可靠识别源语言，请选择更完整的文本后重试。" } }
      }
    },
    "hotkey.conflict" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Global shortcut ⌥D is used by another app. Close the conflicting app and restart TranslateDot." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "全局快捷键 ⌥D 已被其他应用占用，请关闭冲突应用后重新启动 TranslateDot。" } }
      }
    },
    "hotkey.registration_failed" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Couldn't register global shortcut ⌥D. Restart the app." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法注册全局快捷键 ⌥D，请重新启动应用。" } }
      }
    },
    "language.auto_detect" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Auto-detect" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "自动检测" } }
      }
    },
